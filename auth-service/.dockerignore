# Keep the build context small and never send secrets to Docker.
# auth-service/.env holds the database password (and later the JWT secret).
.env
.env.*
!.env.example

target/
.idea/
.vscode/
*.iml
*.log
*.Dockerfile
Dockerfile
.dockerignore

# The Maven Wrapper is for local builds; the builder image has its own Maven.
.mvn/
mvnw
mvnw.cmd
