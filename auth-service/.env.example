# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored. Never commit real passwords.

# --- auth-service-db container ---
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_db

# --- auth-service app (running locally with ./mvnw) ---
# In Docker, override: -e DB_URL=jdbc:postgresql://auth-service-db:5432/auth_db
DB_URL=jdbc:postgresql://localhost:5433/auth_db
DB_USERNAME=auth_user
DB_PASSWORD=change-me

# --- JWT signing key (Base64, at least 32 bytes) ---
# Generate your own with: openssl rand -base64 32
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
