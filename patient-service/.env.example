# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is git-ignored. Never commit real passwords.
#
# These values are for running locally with ./mvnw spring-boot:run.
# In Docker, override the hostnames with container names:
#   -e DB_URL=jdbc:postgresql://patient-service-db:5432/patient_db
#   -e BILLING_SERVICE_ADDRESS=billing-service
#   -e KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/patient_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
SQL_INIT_MODE=always

# --- gRPC client: billing-service ---
BILLING_SERVICE_ADDRESS=localhost
BILLING_SERVICE_GRPC_PORT=9001

# --- Kafka producer ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
